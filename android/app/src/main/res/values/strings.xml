    <!-- About, privacy, and built-in remote guide -->
    <string name="about_action">About and privacy</string>
    <string name="about_title">About DSH Remote</string>
    <string name="about_subtitle">GitHub beta · %1$s</string>
    <string name="about_local_first_title">Your computer remains the host</string>
    <string name="about_local_first_message">DSH Remote has no project-operated relay, account, analytics, advertising, push service, or model gateway. Code, credentials, session history, and execution stay on your computer.</string>
    <string name="about_tailscale_title">Use Tailscale away from Wi-Fi</string>
    <string name="about_tailscale_step_1">Install Tailscale on this Android device and the computer, then sign in to the same Tailnet.</string>
    <string name="about_tailscale_step_2">Open the Tailnet device list and confirm both devices are connected before continuing.</string>
    <string name="about_tailscale_step_3">If Desktop requests it, enable MagicDNS and HTTPS certificates. Device names used by certificates are recorded in public certificate logs.</string>
    <string name="about_tailscale_step_4">In Desktop, enable remote access. Desktop configures Tailscale Serve, the Harness address, and the QR code without terminal commands.</string>
    <string name="about_tailscale_step_5">Scan the remote-access QR code, turn off Wi-Fi, keep cellular data and Tailscale connected, then open a session and send a message.</string>
    <string name="about_tailscale_download_android">Install Tailscale on Android</string>
    <string name="about_tailscale_download_computer">Download Tailscale for the computer</string>
    <string name="about_tailscale_open_admin">Open Tailnet device management</string>
    <string name="about_tailscale_open_dns">Open Tailnet DNS settings</string>
    <string name="about_tailscale_https_guide">Read MagicDNS and HTTPS guidance</string>
    <string name="about_tailscale_serve_guide">Read about Tailscale Serve</string>
    <string name="about_tailscale_funnel_title">Do not use Funnel</string>
    <string name="about_tailscale_funnel_message">DSH Remote uses Tailscale Serve inside your private Tailnet. Funnel would expose the endpoint to the public internet.</string>
    <string name="about_privacy_title">Privacy and support</string>
    <string name="about_privacy_message">Saved computers are encrypted by Android Keystore. Selected photos are resized and re-encoded before transfer. Camera frames are used only to scan a pairing code.</string>
    <string name="about_notification_limit">Task notifications are best effort while the app process is alive. Android may stop them after process death or under manufacturer background restrictions.</string>
    <string name="about_privacy_policy_action">Read privacy policy</string>
    <string name="about_support_action">Open support</string>
