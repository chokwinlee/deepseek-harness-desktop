    <string name="about_title">关于 DSH Remote</string>
    <string name="about_subtitle">GitHub 内测版 · %1$s</string>
    <string name="about_local_first_title">电脑始终是运行宿主</string>
    <string name="about_local_first_message">DSH Remote 没有项目方 relay、账号、分析、广告、推送服务或模型网关。代码、凭证、会话历史和执行都留在你的电脑。</string>
    <string name="about_tailscale_title">离开同一 Wi-Fi 后使用 Tailscale</string>
    <string name="about_tailscale_step_1">在这台 Android 设备和电脑上安装 Tailscale，然后登录同一个 Tailnet。</string>
    <string name="about_tailscale_step_2">打开 Tailnet 设备管理后台，确认两台设备都已连接后再继续。</string>
    <string name="about_tailscale_step_3">如果 Desktop 提示缺少权限，请启用 MagicDNS 与 HTTPS 证书。证书使用的设备名称会记录在公开证书日志中。</string>
    <string name="about_tailscale_step_4">在 Desktop 开启跨网络连接。Desktop 会自动配置 Tailscale Serve、Harness 地址和二维码，无需终端命令。</string>
    <string name="about_tailscale_step_5">扫描跨网络二维码，关闭 Wi-Fi，只保留蜂窝网络和 Tailscale，再打开会话并发送一条消息。</string>
    <string name="about_tailscale_download_android">在 Android 安装 Tailscale</string>
    <string name="about_tailscale_download_computer">下载电脑版 Tailscale</string>
    <string name="about_tailscale_open_admin">打开 Tailnet 设备管理</string>
    <string name="about_tailscale_open_dns">打开 Tailnet DNS 设置</string>
    <string name="about_tailscale_https_guide">查看 MagicDNS 与 HTTPS 指南</string>
    <string name="about_tailscale_serve_guide">查看 Tailscale Serve 说明</string>
    <string name="about_tailscale_funnel_title">不要使用 Funnel</string>
    <string name="about_tailscale_funnel_message">DSH Remote 只使用 Tailnet 内可访问的 Tailscale Serve。Funnel 会把入口暴露到公网。</string>
    <string name="about_privacy_title">隐私与支持</string>
    <string name="about_privacy_message">保存的电脑由 Android Keystore 加密。所选图片会在传输前缩放并重新编码。相机画面只用于扫描配对二维码。</string>
    <string name="about_notification_limit">任务通知只在 App 进程存活时尽力提醒。进程被杀或受到厂商后台限制后，Android 可能停止提醒。</string>
